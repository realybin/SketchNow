<Window x:Class="SketchNow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SketchNow.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:SketchNow"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:properties="clr-namespace:SketchNow.Properties"
        xmlns:enums="clr-namespace:SketchNow.Models.Enums"
        xmlns:valueConverters="http://schemas.superdev.ch/valueconverters/2016/xaml"
        xmlns:views="clr-namespace:SketchNow.Views"
        xmlns:vms="clr-namespace:SketchNow.ViewModels"
        Title="SketchNow"
        Width="800"
        Height="450"
        d:DataContext="{d:DesignInstance IsDesignTimeCreatable=False,
                                         Type={x:Type vms:MainWindowViewModel}}"
        AllowsTransparency="True"
        Background="{Binding OverlayBackground}"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        mc:Ignorable="d">
  <Window.InputBindings>
    <KeyBinding Key="C"
                Command="{Binding SelectToolCommand}"
                CommandParameter="{x:Static enums:DrawingTool.Pointer}"
                Modifiers="Shift" />
    <KeyBinding Key="I"
                Command="{Binding SelectToolCommand}"
                CommandParameter="{x:Static enums:DrawingTool.Pen}"
                Modifiers="Shift" />
    <KeyBinding Key="E"
                Command="{Binding SelectToolCommand}"
                CommandParameter="{x:Static enums:DrawingTool.Eraser}"
                Modifiers="Shift" />
    <KeyBinding Key="S"
                Command="{Binding SelectToolCommand}"
                CommandParameter="{x:Static enums:DrawingTool.Selection}"
                Modifiers="Shift" />
    <KeyBinding Key="S"
                Command="{Binding SelectCanvasModeCommand}"
                CommandParameter="{x:Static enums:CanvasMode.Desktop}"
                Modifiers="Alt" />
    <KeyBinding Key="B"
                Command="{Binding SelectCanvasModeCommand}"
                CommandParameter="{x:Static enums:CanvasMode.Whiteboard}"
                Modifiers="Alt" />
    <KeyBinding Key="Z"
                Command="{Binding Workspace.CurrentPage.UndoCommand}"
                Modifiers="Control" />
    <KeyBinding Key="Y"
                Command="{Binding Workspace.CurrentPage.RedoCommand}"
                Modifiers="Control" />
  </Window.InputBindings>
  <Window.Style>
    <StaticResource ResourceKey="MaterialDesignWindow" />
  </Window.Style>
  <Window.Resources>
    <valueConverters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
  </Window.Resources>
  <Grid>
    <Grid.CacheMode>
      <BitmapCache 
            EnableClearType="True"
            RenderAtScale="1"
            SnapsToDevicePixels="True" />
    </Grid.CacheMode>
    <materialDesign:DialogHost ApplyBlurBackground="True">
      <materialDesign:DialogHost.DialogContent>
        <Grid Margin="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ScrollViewer Grid.Row="0"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <views:SettingsView x:Name="SettingsView"/>
          </ScrollViewer>
          <StackPanel Grid.Row="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Orientation="Horizontal">
            <Button Margin="0,8,8,0"
                  Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                  Content="{x:Static properties:Resource.Close}"
                  IsCancel="True"
                  Style="{StaticResource MaterialDesignFlatButton}" />
          </StackPanel>
        </Grid>
      </materialDesign:DialogHost.DialogContent>
      <Grid>
        <Canvas Background="{Binding Settings.CanvasBackground}" Visibility="{Binding Workspace.IsWhiteboard, Converter={StaticResource BoolToVisibilityConverter}}" />
        <controls:DrawingInkCanvas Background="Transparent"
                                   Cursor="{Binding ToolCursor}"
                                   DefaultDrawingAttributes="{Binding DrawingAttributes}"
                                   EditingMode="{Binding EditingMode}"
                                   Strokes="{Binding Workspace.CurrentPage.Strokes, Mode=OneWay}"
                                   UseCustomCursor="True" />
        <Button HorizontalAlignment="Left"
              VerticalAlignment="Center"
              Background="{DynamicResource MaterialDesignTextFieldBoxBackground}"
              Command="{x:Static materialDesign:DialogHost.OpenDialogCommand}"
              Style="{StaticResource MaterialDesignIconButton}">
          <materialDesign:PackIcon Kind="Settings" />
        </Button>
        <views:PageNavigationView />
        <views:DrawingToolbarView />
      </Grid>
    </materialDesign:DialogHost>
  </Grid>
</Window>
