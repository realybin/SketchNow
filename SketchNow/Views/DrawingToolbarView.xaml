<UserControl x:Class="SketchNow.Views.DrawingToolbarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SketchNow.Controls"
             xmlns:converters="clr-namespace:SketchNow.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:enums="clr-namespace:SketchNow.Models.Enums"
             xmlns:jas="clr-namespace:WPF.JoshSmith.Controls;assembly=WPF.JoshSmith.Controls.DragCanvas"
             xmlns:local="clr-namespace:SketchNow.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:properties="clr-namespace:SketchNow.Properties"
             xmlns:valueConverters="http://schemas.superdev.ch/valueconverters/2016/xaml"
             xmlns:vms="clr-namespace:SketchNow.ViewModels"
             x:Name="ToolbarControl"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=False,
                                              Type={x:Type vms:MainWindowViewModel}}"
             d:DesignHeight="300"
             d:DesignWidth="800"
             mc:Ignorable="d">
  <UserControl.Resources>
    <valueConverters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <converters:ColorToBrushConverter x:Key="ColorToBrushConverter" />
    <converters:DivisionMathConverter x:Key="DivisionMathConverter" />
  </UserControl.Resources>
  <jas:DragCanvas>
    <StackPanel Canvas.Left="{Binding (Canvas.Left), ElementName=ToolbarPanel, ConverterParameter=0, Converter={StaticResource MathAddConverter}}"
                Canvas.Top="{Binding (Canvas.Top), ElementName=ToolbarPanel, ConverterParameter=65, Converter={StaticResource MathAddConverter}}"
                jas:DragCanvas.CanBeDragged="False"
                Orientation="Horizontal">
      <CheckBox x:Name="ToolbarVisibilityToggle"
                Content="{x:Static properties:Resource.Visibility}"
                IsChecked="True"
                Style="{StaticResource MaterialDesignFilterChipCheckBox}" />
      <StackPanel Orientation="Horizontal" Visibility="{Binding IsChecked, ElementName=ToolbarVisibilityToggle, Converter={StaticResource BoolToVisibilityConverter}}">
        <Button Command="{Binding Workspace.CurrentPage.UndoCommand}"
                Content="{materialDesign:PackIcon Kind=Undo}"
                Style="{StaticResource MaterialDesignPaperDarkButton}" />
        <Button Command="{Binding Workspace.CurrentPage.RedoCommand}"
                Content="{materialDesign:PackIcon Kind=Redo}"
                Style="{StaticResource MaterialDesignPaperDarkButton}" />
        <Button Command="{Binding Workspace.CurrentPage.ClearCommand}"
                Content="{materialDesign:PackIcon Kind=Delete}"
                Style="{StaticResource MaterialDesignPaperDarkButton}" />
      </StackPanel>

    </StackPanel>
    <StackPanel x:Name="ToolbarPanel"
                Canvas.Left="{Binding ActualWidth, ElementName=ToolbarControl, Converter={StaticResource DivisionMathConverter}, ConverterParameter=1.75}"
                Canvas.Top="{Binding ActualHeight, ElementName=ToolbarControl, Converter={StaticResource DivisionMathConverter}, ConverterParameter=1.25, Mode=OneWay}"
                Orientation="Horizontal">
      <!-- The nonselectable handle lets mouse events reach DragCanvas. -->
      <ListBox x:Name="ToolbarDragHandle"
               Margin="2"
               Cursor="SizeAll"
               Focusable="False"
               Style="{StaticResource MaterialDesignToolToggleListBox}"
               ToolTip="{x:Static properties:Resource.ToolMoveDescription}">
        <ListBoxItem IsEnabled="False">
          <controls:IconWithText Kind="CursorMove" Text="{x:Static properties:Resource.Move}" />
        </ListBoxItem>
      </ListBox>
      <ListBox Margin="2"
               SelectedValue="{Binding SelectedTool}"
               SelectedValuePath="Tag"
               Style="{StaticResource MaterialDesignToolToggleListBox}"
               Visibility="{Binding IsChecked, ElementName=ToolbarVisibilityToggle, Converter={StaticResource BoolToVisibilityConverter}}">
        <ListBoxItem Tag="{x:Static enums:DrawingTool.Pointer}">
          <controls:IconWithText Kind="CursorDefault"
                                 Text="{x:Static properties:Resource.Cursor}"
                                 ToolTip="{x:Static properties:Resource.ToolCursorDescription}" />
        </ListBoxItem>
        <ListBoxItem x:Name="PenToolItem" Tag="{x:Static enums:DrawingTool.Pen}">
          <controls:IconWithText Kind="Pen"
                                 Text="{x:Static properties:Resource.Ink}"
                                 ToolTip="{x:Static properties:Resource.ToolInkDescription}" />
        </ListBoxItem>
        <ListBoxItem Tag="{x:Static enums:DrawingTool.Eraser}">
          <controls:IconWithText Kind="Eraser"
                                 Text="{x:Static properties:Resource.Eraser}"
                                 ToolTip="{x:Static properties:Resource.ToolEraserDescription}" />
        </ListBoxItem>
        <ListBoxItem Tag="{x:Static enums:DrawingTool.Selection}">
          <controls:IconWithText Kind="Select"
                                 Text="{x:Static properties:Resource.Select}"
                                 ToolTip="{x:Static properties:Resource.ToolSelectDescription}" />
        </ListBoxItem>
      </ListBox>
      <ListBox Margin="2"
               SelectedValue="{Binding Workspace.Mode}"
               SelectedValuePath="Tag"
               Style="{StaticResource MaterialDesignToolToggleListBox}">
        <ListBoxItem Tag="{x:Static enums:CanvasMode.Desktop}">
          <controls:IconWithText Kind="DesktopWindows"
                                 Text="{x:Static properties:Resource.Screen}"
                                 ToolTip="{x:Static properties:Resource.ToolScreenDescription}" />
        </ListBoxItem>
        <ListBoxItem Tag="{x:Static enums:CanvasMode.Whiteboard}">
          <controls:IconWithText Kind="Presentation"
                                 Text="{x:Static properties:Resource.Board}"
                                 ToolTip="{x:Static properties:Resource.ToolBoardDescription}" />
        </ListBoxItem>
      </ListBox>
    </StackPanel>
    <Grid Canvas.Left="{Binding (Canvas.Left), Converter={StaticResource MathAddConverter}, ElementName=ToolbarPanel, ConverterParameter=80}"
          Canvas.Top="{Binding (Canvas.Top), ConverterParameter=-36, Converter={StaticResource MathAddConverter}, ElementName=ToolbarPanel}"
          jas:DragCanvas.CanBeDragged="False"
          Visibility="{Binding IsChecked, ElementName=ToolbarVisibilityToggle, Converter={StaticResource BoolToVisibilityConverter}}">
      <StackPanel Orientation="Horizontal" Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}, ElementName=PenToolItem}">
        <ListBox x:Name="InkColorList"
                 Margin="1"
                 ItemsSource="{Binding InkColors}"
                 SelectedItem="{Binding SelectedInkColor, Mode=TwoWay}"
                 Style="{StaticResource MaterialDesignToolToggleListBox}">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="materialDesign:PackIcon">
              <materialDesign:PackIcon Foreground="{Binding Converter={StaticResource ColorToBrushConverter}}" Kind="Circle" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <ListBox Margin="1"
                 ItemsSource="{Binding StrokeWidths}"
                 SelectedItem="{Binding SelectedStrokeWidth}"
                 Style="{StaticResource MaterialDesignToolToggleListBox}">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="materialDesign:PackIcon">
              <materialDesign:PackIcon Width="{Binding}"
                                       Foreground="{Binding SelectedItem, ElementName=InkColorList, Converter={StaticResource ColorToBrushConverter}}"
                                       Kind="Circle" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
    </Grid>

  </jas:DragCanvas>
</UserControl>
